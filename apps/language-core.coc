# Variables, Ptolomaea calls, loops, comparisons and Judecca memory.
var counter 5 0
jump main

ptolomaea twice
dup
add
return

label main
load counter
call twice
print
drop

push 2 0
push 3 0
lt
print
drop
push 3 0
push 2 0
gt
print
drop
push 4 0
push 4 0
eq
print
drop

label countdown
load counter
print
load counter
push 1 0
sub
dup
store counter
jnz countdown

judecca 7 2
push 7 0
push 65 0
mstore
push 7 0
mload
emit
